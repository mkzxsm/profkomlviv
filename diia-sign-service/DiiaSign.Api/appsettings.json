{
  "Diia": {
    "Environment": "Sandbox",
    "BaseUrl": "https://api2s.diia.gov.ua",
    "AcquirerToken": "",
    "AuthAcquirerToken": "",
    "BranchId": "",
    "OfferId": "",
    "SignAlgorithm": "ECDSA",
    "AllowedReturnLinkPrefix": "",
    "RequestTimeoutSeconds": 20
  },
  "Signing": {
    "CallbackWindowMinutes": 10,
    "MaxPdfBytes": 10485760,
    "RetentionDays": 7,
    "StatusPollIntervalSeconds": 5
  },
  "Verification": {
    "CaCertificatesPath": "certs/CACertificates.Test.All.p7b",
    "MaxClockSkewMinutes": 5
  },
  "Security": {
    "InternalApiKey": "",
    "AdminApiKey": "",
    "KnownProxies": [],
    "CallbackPermitsPerMinute": 30
  },
  "ConnectionStrings": {
    "SignDb": "Data Source=data/diia-sign.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
